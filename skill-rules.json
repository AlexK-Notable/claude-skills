{
  "version": "1.0",
  "description": "Skill activation triggers customized for MCP/Python/TypeScript development",
  "skills": {
    "hierarchical-dev-orchestrator": {
      "type": "domain",
      "enforcement": "suggest",
      "priority": "high",
      "description": "Multi-tier orchestration for complex software development tasks",
      "promptTriggers": {
        "keywords": [
          "debug",
          "refactor",
          "architecture",
          "complex bug",
          "orchestrate",
          "stuck",
          "challenging problem",
          "architectural decision",
          "systems thinking",
          "multi-tier"
        ],
        "intentPatterns": [
          "(debug|fix|solve).*?(complex|difficult|challenging|stuck|intractable)",
          "(refactor|redesign|restructure).*?(architecture|system|codebase)",
          "(need|want).*?(systems|architectural|high.?level).*?(perspective|guidance)",
          "escalate.*?(haiku|sonnet|opus)"
        ]
      },
      "fileTriggers": {
        "pathPatterns": [
          "**/*.py",
          "**/*.ts",
          "**/*.tsx",
          "**/*.js",
          "**/*.jsx"
        ]
      }
    },
    "skill-developer": {
      "type": "domain",
      "enforcement": "suggest",
      "priority": "high",
      "description": "Meta-skill for creating and managing Claude Code skills",
      "promptTriggers": {
        "keywords": [
          "skill",
          "skill-rules",
          "hook",
          "trigger pattern",
          "create skill",
          "add skill",
          "skill activation",
          "skill system",
          "progressive disclosure",
          "skill triggers"
        ],
        "intentPatterns": [
          "(create|add|modify|update|build).*?skill",
          "skill.*?(trigger|activate|work|system|pattern)",
          "(how do|how does|explain).*?skill",
          "(write|develop).*?(skill|hook)"
        ]
      },
      "fileTriggers": {
        "pathPatterns": [
          "**/.claude/skills/**/*.md",
          "**/skills/**/*.md",
          "**/claude-skills/**/*.md",
          "**/.claude/skills/skill-rules.json",
          "**/.claude/hooks/**/*.sh",
          "**/.claude/hooks/**/*.ts"
        ]
      }
    },
    "mcp-server-maintainer": {
      "type": "domain",
      "enforcement": "suggest",
      "priority": "high",
      "description": "Installing, configuring, and troubleshooting MCP servers",
      "promptTriggers": {
        "keywords": [
          "mcp server",
          "install mcp",
          "mcp not working",
          "mcp connection",
          "mcp configuration",
          "server not found",
          "claude desktop config",
          "claude_desktop_config.json",
          "stdio transport",
          "mcp tools",
          "configure mcp"
        ],
        "intentPatterns": [
          "(install|add|setup|configure).*?mcp.*?server",
          "mcp.*?(not working|error|failed|connection|issue)",
          "(fix|debug|troubleshoot).*?mcp",
          "server.*?(not showing|not found|not appearing)",
          "(how to|how do I).*?(install|configure|setup).*?mcp"
        ]
      },
      "fileTriggers": {
        "pathPatterns": [
          "**/MCP/**/*.py",
          "**/MCP/**/*.ts",
          "**/MCP/**/*.js",
          "**/mcp*/**/*",
          "**/claude_desktop_config.json",
          "**/.claude/settings.json"
        ],
        "contentPatterns": [
          "from mcp",
          "import mcp",
          "@modelcontextprotocol",
          "mcpServers",
          "FastMCP"
        ]
      }
    },
    "mcp-server-discovery": {
      "type": "domain",
      "enforcement": "suggest",
      "priority": "high",
      "description": "Discover and recommend task-appropriate MCP servers for code analysis, visualization, diagrams, mind maps, documentation, knowledge management, system operations, reasoning, academic research, and package security",
      "promptTriggers": {
        "keywords": [
          "diagram",
          "flowchart",
          "mind map",
          "visualize",
          "chart",
          "mermaid",
          "sequence diagram",
          "analyze code",
          "code structure",
          "distill",
          "go documentation",
          "go package",
          "research papers",
          "academic",
          "arxiv",
          "citations",
          "scholar",
          "semantic scholar",
          "documentation",
          "library docs",
          "api reference",
          "knowledge base",
          "notes",
          "zettelkasten",
          "pkm",
          "convert",
          "pdf to markdown",
          "download website",
          "parse html",
          "csv file",
          "json data",
          "local file",
          "analyze file",
          "system file",
          "think through",
          "break down problem",
          "reason about",
          "cognitive",
          "npm package",
          "vulnerability",
          "which mcp",
          "available servers",
          "mcp tools",
          "what servers"
        ],
        "intentPatterns": [
          "(create|make|generate|build).*(diagram|flowchart|mind map|visualization|chart|graph)",
          "(analyze|examine|study|review).*(code|codebase|file|csv|json|data|structure)",
          "(find|search|look for|research).*(papers|documentation|docs|academic|arxiv|scholar)",
          "(save|store|remember|note|document).*(knowledge|insight|idea|information)",
          "(convert|process|transform|download).*(pdf|document|website|markdown)",
          "(solve|break down|think through|reason about).*(problem|challenge|task|question)",
          "(check|analyze|compare|evaluate).*(npm|package|dependency|dependencies)",
          "(which|what|available|recommend).*(mcp|server|tool|servers)",
          "(i want to|i need to).*(visualize|diagram|analyze|research|convert|document)",
          "(show me|display).*(diagram|visualization|analysis|documentation|papers)"
        ]
      }
    },
    "python-rich-cli": {
      "type": "domain",
      "enforcement": "suggest",
      "priority": "high",
      "description": "Building CLI tools with Python Rich library",
      "promptTriggers": {
        "keywords": [
          "rich",
          "console",
          "cli output",
          "terminal output",
          "progress bar",
          "table",
          "rich formatting",
          "cli tool",
          "terminal ui",
          "command line interface"
        ],
        "intentPatterns": [
          "(create|build|make).*?(cli|terminal).*?tool",
          "(add|implement|use).*?(progress|table|rich).*?output",
          "(format|style|beautify).*?(terminal|cli|console).*?output",
          "rich.*?(library|console|formatting)"
        ]
      },
      "fileTriggers": {
        "pathPatterns": [
          "**/*.py"
        ],
        "contentPatterns": [
          "from rich",
          "import rich",
          "Console\\(",
          "Progress\\(",
          "Table\\("
        ]
      }
    },
    "obsidian-plugin-dev": {
      "type": "domain",
      "enforcement": "suggest",
      "priority": "high",
      "description": "Developing Obsidian plugins with TypeScript and React",
      "promptTriggers": {
        "keywords": [
          "obsidian plugin",
          "obsidian api",
          "plugin development",
          "obsidian",
          "plugin settings",
          "obsidian view",
          "obsidian modal",
          "manifest.json"
        ],
        "intentPatterns": [
          "(create|build|develop).*?obsidian.*?plugin",
          "obsidian.*?(api|plugin|development)",
          "(add|implement).*?(view|modal|settings).*?obsidian",
          "plugin.*?(obsidian|manifest)"
        ]
      },
      "fileTriggers": {
        "pathPatterns": [
          "**/obsidian-*/**/*.ts",
          "**/obsidian-*/**/*.tsx",
          "**/obsidian-*/**/*.js",
          "**/obsidian-*/manifest.json"
        ],
        "contentPatterns": [
          "from \"obsidian\"",
          "extends Plugin",
          "PluginSettingTab",
          "ItemView",
          "Modal"
        ]
      }
    },
    "gtk-pygobject-dev": {
      "type": "domain",
      "enforcement": "suggest",
      "priority": "high",
      "description": "Building desktop applications with GTK, PyGObject, and DBus",
      "promptTriggers": {
        "keywords": [
          "gtk",
          "pygobject",
          "dbus",
          "glib",
          "desktop widget",
          "gtk application",
          "gtk window",
          "desktop app",
          "gi.repository",
          "layer shell"
        ],
        "intentPatterns": [
          "(create|build|develop).*?(gtk|desktop).*?(app|widget|window)",
          "gtk.*?(application|widget|development)",
          "(use|implement).*?(dbus|glib|pygobject)",
          "desktop.*?(widget|shell|component)"
        ]
      },
      "fileTriggers": {
        "pathPatterns": [
          "**/ignis/**/*.py",
          "**/gtk/**/*.py",
          "**/*gtk*/**/*.py"
        ],
        "contentPatterns": [
          "from gi.repository import Gtk",
          "from gi.repository import GLib",
          "gi.require_version",
          "Gtk.Application",
          "Gtk.Window",
          "DBus"
        ]
      }
    }
  },
  "notes": {
    "enforcement_types": {
      "suggest": "Skill suggestion appears but doesn't block execution",
      "block": "Requires skill to be used before proceeding (guardrail)",
      "warn": "Shows warning but allows proceeding"
    },
    "priority_levels": {
      "critical": "Highest - Always trigger when matched",
      "high": "Important - Trigger for most matches",
      "medium": "Moderate - Trigger for clear matches",
      "low": "Optional - Trigger only for explicit matches"
    },
    "customization": {
      "pathPatterns": "Customized for your actual project structures (Python MCP servers, TypeScript tools, GTK apps)",
      "keywords": "Focused on your tech stack: MCP servers, Rich CLI, Obsidian plugins, GTK/PyGObject",
      "intentPatterns": "Regex patterns for flexible user intent matching"
    },
    "skills_installed": {
      "hierarchical-dev-orchestrator": "Your existing orchestration skill",
      "skill-developer": "Meta-skill for skill creation",
      "mcp-server-maintainer": "Custom skill for your MCP server work",
      "mcp-server-discovery": "Task-to-MCP-server routing and recommendations",
      "python-rich-cli": "Custom skill for CLI tools with Rich",
      "obsidian-plugin-dev": "Custom skill for Obsidian plugin development",
      "gtk-pygobject-dev": "Custom skill for GTK desktop development"
    }
  }
