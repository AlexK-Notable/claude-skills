{
  "version": "1.0",
  "description": "Skill activation triggers customized for MCP/Python/TypeScript development",
  "skills": {
    "hierarchical-dev-orchestrator": {
      "type": "domain",
      "enforcement": "suggest",
      "priority": "high",
      "description": "Multi-tier orchestration for complex software development tasks",
      "promptTriggers": {
        "keywords": [
          "debug",
          "refactor",
          "architecture",
          "complex bug",
          "orchestrate",
          "stuck",
          "challenging problem",
          "architectural decision",
          "systems thinking",
          "multi-tier"
        ],
        "intentPatterns": [
          "(debug|fix|solve).*?(complex|difficult|challenging|stuck|intractable)",
          "(refactor|redesign|restructure).*?(architecture|system|codebase)",
          "(need|want).*?(systems|architectural|high.?level).*?(perspective|guidance)",
          "escalate.*?(haiku|sonnet|opus)"
        ]
      },
      "fileTriggers": {
        "pathPatterns": [
          "**/*.py",
          "**/*.ts",
          "**/*.tsx",
          "**/*.js",
          "**/*.jsx"
        ]
      }
    },
    "skill-developer": {
      "type": "domain",
      "enforcement": "suggest",
      "priority": "high",
      "description": "Meta-skill for creating and managing Claude Code skills",
      "promptTriggers": {
        "keywords": [
          "skill",
          "skill-rules",
          "hook",
          "trigger pattern",
          "create skill",
          "add skill",
          "skill activation",
          "skill system",
          "progressive disclosure",
          "skill triggers"
        ],
        "intentPatterns": [
          "(create|add|modify|update|build).*?skill",
          "skill.*?(trigger|activate|work|system|pattern)",
          "(how do|how does|explain).*?skill",
          "(write|develop).*?(skill|hook)"
        ]
      },
      "fileTriggers": {
        "pathPatterns": [
          "**/.claude/skills/**/*.md",
          "**/skills/**/*.md",
          "**/claude-skills/**/*.md",
          "**/.claude/skills/skill-rules.json",
          "**/.claude/hooks/**/*.sh",
          "**/.claude/hooks/**/*.ts"
        ]
      }
    },
    "mcp-server-maintainer": {
      "type": "domain",
      "enforcement": "suggest",
      "priority": "high",
      "description": "Installing, configuring, and troubleshooting MCP servers",
      "promptTriggers": {
        "keywords": [
          "mcp server",
          "install mcp",
          "mcp not working",
          "mcp connection",
          "mcp configuration",
          "server not found",
          "claude desktop config",
          "claude_desktop_config.json",
          "stdio transport",
          "mcp tools",
          "configure mcp"
        ],
        "intentPatterns": [
          "(install|add|setup|configure).*?mcp.*?server",
          "mcp.*?(not working|error|failed|connection|issue)",
          "(fix|debug|troubleshoot).*?mcp",
          "server.*?(not showing|not found|not appearing)",
          "(how to|how do I).*?(install|configure|setup).*?mcp"
        ]
      },
      "fileTriggers": {
        "pathPatterns": [
          "**/MCP/**/*.py",
          "**/MCP/**/*.ts",
          "**/MCP/**/*.js",
          "**/mcp*/**/*",
          "**/claude_desktop_config.json",
          "**/.claude/settings.json"
        ],
        "contentPatterns": [
          "from mcp",
          "import mcp",
          "@modelcontextprotocol",
          "mcpServers",
          "FastMCP"
        ]
      }
    },
