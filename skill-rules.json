    "python-rich-cli": {
      "type": "domain",
      "enforcement": "suggest",
      "priority": "high",
      "description": "Building CLI tools with Python Rich library",
      "promptTriggers": {
        "keywords": [
          "rich",
          "console",
          "cli output",
          "terminal output",
          "progress bar",
          "table",
          "rich formatting",
          "cli tool",
          "terminal ui",
          "command line interface"
