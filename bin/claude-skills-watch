#!/usr/bin/env bash
# claude-skills-watch — recursive inotify watch on the repo; debounce-sync on change.
# Run as a systemd --user service (claude-skills-autosync.service).
set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
command -v inotifywait >/dev/null || { echo "claude-skills-watch: needs inotify-tools" >&2; exit 1; }

# Block until something under REPO changes (ignoring .git churn and build/runtime
# artifacts — watching cron-claude's .venv alone would burn ~1700 inotify watches
# and make every `uv sync` fire a no-op sync), then debounce a burst of edits and
# sync once. Loop forever; the sync is loop-safe.
EXCLUDE='/(\.git|\.venv|venv|__pycache__|node_modules|\.captures|\.home-net-queue|run)/'
while inotifywait -r -q -e modify,create,delete,move --exclude "$EXCLUDE" "$REPO" >/dev/null 2>&1; do
  sleep 5
  "$REPO/bin/claude-skills-sync" || true
done

# inotifywait failed (watch-limit exhaustion, etc.). Exit nonzero so systemd's
# Restart= policy revives the watcher instead of letting autosync die silently.
echo "claude-skills-watch: inotifywait exited — restarting via systemd" >&2
exit 1
