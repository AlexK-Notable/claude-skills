#!/usr/bin/env bash
# claude-skills-sync — keep the claude-skills remote current. Loop-safe.
# Commits + pushes only when there are real (non-.git) changes; rebases before
# pushing for multi-machine safety; stops + notifies on conflict (never auto-resolves).
set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO"

# self-learn autosync-pause sentinel (docs/specs/self-learn 02 §3 / 08 T12):
# while a review/apply flow holds the sentinel (mtime < 2 h), skip sync
# entirely — exit 0, commit nothing. Stale sentinels are ignored.
SELF_LEARN_SENTINEL="${XDG_CACHE_HOME:-$HOME/.cache}/claude-skills/self-learn/autosync-pause"
if [ -f "$SELF_LEARN_SENTINEL" ] && [ -n "$(find "$SELF_LEARN_SENTINEL" -mmin -120 2>/dev/null)" ]; then
  echo "claude-skills-sync: paused by self-learn sentinel ($SELF_LEARN_SENTINEL)" >&2
  exit 0
fi

note() { command -v notify-send >/dev/null && notify-send "claude-skills sync" "$1" || echo "$1" >&2; }

# Nothing to commit? just keep up with the remote and exit (no loop).
if [ -z "$(git status --porcelain)" ]; then
  git fetch -q origin || true
  git merge --ff-only -q "@{u}" 2>/dev/null || true
  exit 0
fi

if ! git pull --rebase --autostash -q; then
  git rebase --abort 2>/dev/null || true
  note "rebase conflict — resolve manually in $REPO"
  exit 1
fi

git add -A
git commit -q -m "autosync $(date -u +%Y-%m-%dT%H:%M:%SZ)" || true
if ! git push -q; then
  note "push failed (network/auth) — will retry on next change"
  exit 1
fi
