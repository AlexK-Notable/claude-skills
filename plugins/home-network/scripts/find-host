#!/usr/bin/env bash
# find-host — resolve a host using multiple methods (DNS → mDNS → ARP cache).
# Works in both directions: name → IP, and IP → name.

set -euo pipefail

have() { command -v "$1" >/dev/null 2>&1; }

if [[ -t 1 ]] && command -v tput >/dev/null 2>&1; then
  C_OK=$(tput setaf 2); C_DIM=$(tput dim); C_BOLD=$(tput bold); C_RESET=$(tput sgr0)
else
  C_OK=""; C_DIM=""; C_BOLD=""; C_RESET=""
fi

usage() {
  cat <<'EOF'
find-host — multi-protocol host resolver

USAGE:
  find-host bredos          # name → IP (DNS → mDNS → ARP → reverse)
  find-host 192.168.1.221   # IP → name (PTR → mDNS → ARP cache)
  find-host bredos --first  # stop at first successful method

Tries each method and shows what each one returned. Useful for diagnosing
"DNS says X but mDNS says Y" mismatches.

REQUIRES: bash, getent (always present)
OPTIONAL: avahi-resolve, dig
EOF
}

FIRST_ONLY=0
QUERY=""
for arg in "$@"; do
  case "$arg" in
    -h|--help) usage; exit 0 ;;
    --first) FIRST_ONLY=1 ;;
    *) [[ -z "$QUERY" ]] && QUERY="$arg" ;;
  esac
done

[[ -z "$QUERY" ]] && { usage >&2; exit 2; }

# determine direction: IP or name?
DIRECTION=name2ip
if [[ "$QUERY" =~ ^[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}$ ]]; then
  DIRECTION=ip2name
fi

echo "${C_BOLD}find-host${C_RESET} ${QUERY} ${C_DIM}(${DIRECTION})${C_RESET}"
echo

answered=0
report() {
  local method="$1" result="$2"
  if [[ -n "$result" ]]; then
    printf "  ${C_OK}✓${C_RESET} %-20s %s\n" "$method" "$result"
    answered=$((answered+1))
    if (( FIRST_ONLY )); then
      exit 0
    fi
  else
    printf "  ${C_DIM}✗ %-20s (no answer)${C_RESET}\n" "$method"
  fi
}

if [[ "$DIRECTION" == "name2ip" ]]; then
  # method 1: system DNS via NSS
  if have getent; then
    result=$({ getent hosts "$QUERY" 2>/dev/null | awk '{print $1}' | paste -sd, -; } || true)
    report "system DNS" "$result"
  fi

  # method 2: mDNS (.local)
  name_local="$QUERY"
  [[ "$QUERY" != *.local ]] && name_local="${QUERY}.local"
  if have avahi-resolve; then
    v4=$({ timeout 3 avahi-resolve -4 -n "$name_local" 2>/dev/null | awk '{print $2}'; } || true)
    v6=$({ timeout 3 avahi-resolve -6 -n "$name_local" 2>/dev/null | awk '{print $2}'; } || true)
    combined=""
    [[ -n "$v4" ]] && combined="$v4"
    [[ -n "$v6" ]] && combined="${combined:+$combined, }$v6"
    report "mDNS (.local)" "$combined"
  else
    report "mDNS (.local)" ""
  fi

  # method 3: dig (direct DNS, bypass NSS)
  if have dig; then
    result=$({ dig +short +time=2 +tries=1 "$QUERY" 2>/dev/null | paste -sd, -; } || true)
    report "dig (direct DNS)" "$result"
  fi

  # method 4: ARP cache reverse — only useful if we already know the IP
  # skip for name2ip direction.

else
  # IP → name

  # method 1: reverse DNS
  if have dig; then
    result=$({ dig +short +time=2 +tries=1 -x "$QUERY" 2>/dev/null | sed 's/\.$//' | paste -sd, -; } || true)
    report "reverse DNS (PTR)" "$result"
  fi

  if have getent; then
    result=$({ getent hosts "$QUERY" 2>/dev/null | awk '{$1=""; print $0}' | xargs; } || true)
    report "getent hosts" "$result"
  fi

  # method 2: ARP cache — get MAC + lookup OUI vendor (optional)
  if have ip; then
    arp_entry=$(ip neigh show "$QUERY" 2>/dev/null)
    if [[ -n "$arp_entry" ]]; then
      mac=$(echo "$arp_entry" | awk '{for(i=1;i<=NF;i++) if($i=="lladdr") print $(i+1)}')
      state=$(echo "$arp_entry" | awk '{print $NF}')
      report "ARP cache" "MAC=$mac state=$state"
    else
      report "ARP cache" ""
    fi
  fi

  # method 3: mDNS PTR query — avahi-resolve has -a flag for this
  if have avahi-resolve; then
    result=$({ timeout 3 avahi-resolve -a "$QUERY" 2>/dev/null | awk '{print $2}'; } || true)
    report "mDNS reverse" "$result"
  fi
fi

echo
if (( answered == 0 )); then
  echo "${C_DIM}no resolution found via any method${C_RESET}"
  exit 1
fi
