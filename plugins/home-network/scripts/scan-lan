#!/usr/bin/env bash
# scan-lan — discover devices on a LAN using mDNS + ARP + TCP (NOT ICMP).
#
# Designed around the principle from DISCOVERY.md: ICMP is not authoritative.
# Devices with firewalls drop ICMP echo; mDNS and ARP are more reliable.

set -euo pipefail

# --- helpers ---
have() { command -v "$1" >/dev/null 2>&1; }
warn() { echo "scan-lan: $*" >&2; }

if [[ -t 1 ]] && command -v tput >/dev/null 2>&1; then
  C_OK=$(tput setaf 2); C_DIM=$(tput dim); C_BOLD=$(tput bold); C_RESET=$(tput sgr0)
else
  C_OK=""; C_DIM=""; C_BOLD=""; C_RESET=""
fi

usage() {
  cat <<'EOF'
scan-lan — discover devices on a LAN (mDNS + ARP + TCP, no ICMP)

USAGE:
  scan-lan                       # auto-detect subnet from default route
  scan-lan 192.168.1.0/24        # specific subnet
  scan-lan --quick               # ARP cache + mDNS browse, skip active probes
  scan-lan --deep                # add nmap if available
  scan-lan -i eth0               # specify interface
  scan-lan --ports 22,80,443     # custom port list for TCP fanout

REQUIRES:
  - bash (for /dev/tcp)
  - ip (preinstalled on Linux)

OPTIONAL (better results with):
  - avahi-browse + avahi-resolve (mDNS)
  - arp-scan (one-shot subnet ARP sweep — best active probe)
  - fping (parallel ICMP sweep — second choice)
  - arping (per-host L2 ARP probes — third choice)
  - nmap (--deep)

Run `home-net-doctor` to see what's installed.
EOF
}

# --- args ---
MODE=normal
SUBNET=""
IFACE=""
PORTS="22,80,443,8080,8123"
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --quick) MODE=quick; shift ;;
    --deep) MODE=deep; shift ;;
    -i|--iface) IFACE="$2"; shift 2 ;;
    --ports) PORTS="$2"; shift 2 ;;
    -*) warn "unknown flag: $1"; usage >&2; exit 2 ;;
    *) SUBNET="$1"; shift ;;
  esac
done

# --- detect subnet + interface if not given ---
if [[ -z "$SUBNET" || -z "$IFACE" ]]; then
  default_iface=$(ip -4 route show default 2>/dev/null | awk '{print $5; exit}')
  if [[ -z "${default_iface:-}" ]]; then
    warn "no default route — please specify subnet and interface"
    exit 2
  fi
  [[ -z "$IFACE" ]] && IFACE="$default_iface"
  if [[ -z "$SUBNET" ]]; then
    SUBNET=$(ip -4 -o addr show dev "$IFACE" | awk '{print $4; exit}')
    if [[ -z "$SUBNET" ]]; then
      warn "no IPv4 address on $IFACE"
      exit 2
    fi
  fi
fi

# normalize subnet: ensure /CIDR
[[ "$SUBNET" != */* ]] && SUBNET="${SUBNET}/24"

# --- expand subnet to IP list (only /24 supported for now) ---
prefix="${SUBNET%/*}"
mask="${SUBNET#*/}"
if [[ "$mask" != "24" ]]; then
  warn "only /24 subnets supported in v0.1 — got /$mask"
  warn "to scan a /16 or smaller, split into /24 chunks or use nmap directly"
  exit 2
fi
base="${prefix%.*}"

echo "${C_BOLD}scan-lan${C_RESET}  subnet=${SUBNET}  iface=${IFACE}  mode=${MODE}"
echo

# --- phase 1: read existing ARP cache ---
declare -A SEEN
declare -A MACS
declare -A NAMES
declare -A PORTS_OPEN
declare -A SOURCES

while read -r ip _ _ _ mac _; do
  [[ "$ip" =~ ^${base//./\\.}\. ]] || continue
  [[ "$mac" =~ ^[0-9a-f:]{17}$ ]] || continue
  SEEN["$ip"]=1
  MACS["$ip"]="$mac"
  SOURCES["$ip"]="arp-cache"
done < <(ip neigh show 2>/dev/null)

# --- phase 2: mDNS browse ---
if have avahi-browse; then
  while IFS=';' read -r typ _iface proto _name _svc _dom host addr port _txt; do
    [[ "$typ" == "=" ]] || continue
    [[ "$proto" == "IPv4" ]] || continue
    [[ -z "$addr" || "$addr" == "n/a" ]] && continue
    [[ "$addr" =~ ^${base//./\\.}\. ]] || continue
    SEEN["$addr"]=1
    [[ -z "${NAMES[$addr]:-}" ]] && NAMES["$addr"]="$host"
    [[ -z "${SOURCES[$addr]:-}" ]] && SOURCES["$addr"]="mdns"
    # accumulate service ports
    PORTS_OPEN["$addr"]="${PORTS_OPEN[$addr]:-}${port:+$port }"
  done < <(timeout 6 avahi-browse -arpt 2>/dev/null || true)
else
  warn "avahi-browse not installed — skipping mDNS phase"
fi

# arping needs cap_net_raw (or root); without it every probe fails silently
# (rc=2, "socket: Operation not permitted") and the ARP phase learns nothing.
# Trial-run one probe to verify it's actually usable, not just present.
arping_usable() {
  have arping || return 1
  local rc=0
  arping -c 1 -w 1 -I "$IFACE" "${base}.254" >/dev/null 2>&1 || rc=$?
  (( rc < 2 ))   # 0=reply, 1=no reply — both prove the raw socket opened
}

# harvest IP→MAC pairs for our subnet from the kernel ARP cache into SEEN/MACS
harvest_arp_cache() { # $1 = source tag
  local tag="$1" ip mac _x
  while read -r ip _x _x _x mac _x; do
    [[ "$ip" =~ ^${base//./\\.}\. ]] || continue
    [[ "$mac" =~ ^[0-9a-f:]{17}$ ]] || continue
    SEEN["$ip"]=1
    MACS["$ip"]="$mac"
    [[ -z "${SOURCES[$ip]:-}" ]] && SOURCES["$ip"]="$tag"
  done < <(ip neigh show 2>/dev/null)
}

if [[ "$MODE" == "quick" ]]; then
  # quick mode: skip active probing and TCP fanout
  :
else
  # --- phase 3: active sweep — best available tool wins ---
  # Preference order (see TOOLS.md "Active discovery"):
  #   arp-scan : one process ARP-sweeps the whole /24 in <1s and prints
  #              IP/MAC/vendor directly — authoritative on-LAN
  #   fping    : parallel ICMP sweep (~1s); alive list + ARP cache side effect
  #   arping   : per-host ARP probes (254 background jobs, needs cap_net_raw)
  #   /dev/tcp : TCP cache-warming, no caps needed — last resort
  # All raw-socket tools degrade to the next rung if caps are missing.
  swept=""

  if have arp-scan; then
    out=""
    if out=$(arp-scan --interface="$IFACE" --retry=2 "$SUBNET" 2>/dev/null); then
      while IFS=$'\t' read -r ip mac vendor; do
        [[ "$ip" =~ ^${base//./\\.}\. ]] || continue
        [[ "$mac" =~ ^[0-9a-f:]{17}$ ]] || continue
        SEEN["$ip"]=1
        MACS["$ip"]="$mac"
        # vendor string is a useful identity hint when mDNS gave us no name
        [[ -z "${NAMES[$ip]:-}" && -n "${vendor:-}" && "$vendor" != "(Unknown)" ]] \
          && NAMES["$ip"]="(${vendor})"
        [[ -z "${SOURCES[$ip]:-}" ]] && SOURCES["$ip"]="arp-scan"
      done <<< "$out"
      swept="arp-scan"
    else
      warn "arp-scan failed (missing cap_net_raw? fix: sudo setcap cap_net_raw+eip \$(command -v arp-scan)) — falling back"
    fi
  fi

  if [[ -z "$swept" ]] && have fping; then
    # fping exits 0 (all alive) or 1 (some unreachable — normal for a sweep);
    # >=2 means it couldn't run. -a prints alive IPs; ARP cache fills as a
    # side effect, harvested for MACs below.
    rc=0
    out=$(fping -a -q -g "$SUBNET" -r 1 -t 300 2>/dev/null) || rc=$?
    if (( rc <= 1 )); then
      while read -r ip; do
        [[ "$ip" =~ ^${base//./\\.}\. ]] || continue
        SEEN["$ip"]=1
        [[ -z "${SOURCES[$ip]:-}" ]] && SOURCES["$ip"]="fping"
      done <<< "$out"
      harvest_arp_cache "fping"
      swept="fping"
    else
      warn "fping failed (rc=$rc, missing cap_net_raw?) — falling back"
    fi
  fi

  if [[ -z "$swept" ]] && have arping; then
    if arping_usable; then
      # arping populates the kernel's ARP cache as a side effect.
      # We don't read its stdout — we re-read the ARP cache after all probes settle.
      for i in $(seq 1 254); do
        arping -c 1 -w 1 -I "$IFACE" "${base}.${i}" >/dev/null 2>&1 &
      done
      wait
      harvest_arp_cache "arp-probe"
      swept="arping"
    else
      warn "arping present but unusable (no cap_net_raw) — fix: sudo setcap cap_net_raw+eip \$(command -v arping)"
    fi
  fi

  if [[ -z "$swept" ]]; then
    warn "no usable ARP/ICMP sweep tool — using TCP cache-warming (slowest, least complete)"
    # fallback: try /dev/tcp to a likely port to force ARP discovery.
    # $0/$1-style argument passing keeps the host out of the parsed script
    # text (no interpolation injection).
    for i in $(seq 1 254); do
      ( timeout 0.5 bash -c 'exec 3<>"/dev/tcp/$0/22"' "${base}.${i}" 2>/dev/null || true ) &
    done
    wait
    harvest_arp_cache "tcp-warm"
  fi

  # --- phase 4: TCP fanout on alive hosts (parallel, capped at ~32 jobs) ---
  IFS=',' read -r -a port_array <<< "$PORTS"
  if (( ${#SEEN[@]} > 0 )); then
    declare -A TCP_FOUND
    while read -r ip port; do
      [[ -n "$ip" && -n "$port" ]] || continue
      TCP_FOUND["$ip"]="${TCP_FOUND[$ip]:-}${port},"
    done < <(
      jobs_running=0
      for ip in "${!SEEN[@]}"; do
        for port in "${port_array[@]}"; do
          { timeout 1 bash -c 'exec 3<>"/dev/tcp/$0/$1"' "$ip" "$port" 2>/dev/null \
              && echo "$ip $port"; } &
          jobs_running=$((jobs_running + 1))
          if (( jobs_running >= 32 )); then wait; jobs_running=0; fi
        done
      done
      wait
    ) || true
    for ip in "${!TCP_FOUND[@]}"; do
      PORTS_OPEN["$ip"]="${TCP_FOUND[$ip]%,}"
    done
  fi

  # --- phase 5: deep mode ---
  if [[ "$MODE" == "deep" ]] && have nmap; then
    echo "${C_DIM}running deep nmap (this is slower)…${C_RESET}"
    nmap -PR -PS22,80,443 -sn "$SUBNET" 2>/dev/null | grep -E "Nmap scan|MAC Address" || true
  elif [[ "$MODE" == "deep" ]]; then
    warn "nmap not installed — --deep is a no-op"
  fi
fi

# --- output ---
echo
printf "${C_BOLD}%-16s %-18s %-26s %-24s %s${C_RESET}\n" "IP" "MAC" "HOST/SERVICE" "OPEN PORTS" "SRC"
printf '%s\n' "------------------------------------------------------------------------------------------------------------"
if (( ${#SEEN[@]} > 0 )); then
  # sort IPs numerically by last octet
  for ip in $(printf '%s\n' "${!SEEN[@]}" | sort -t. -k4 -n); do
    printf "%-16s %-18s %-26s %-24s ${C_DIM}%s${C_RESET}\n" \
      "$ip" \
      "${MACS[$ip]:--}" \
      "${NAMES[$ip]:--}" \
      "${PORTS_OPEN[$ip]:--}" \
      "${SOURCES[$ip]:--}"
  done
fi
echo
echo "${C_OK}found ${#SEEN[@]} hosts${C_RESET}"
