#!/usr/bin/env bash
# wol — Wake-on-LAN sender. Accepts a raw MAC or a device alias from DEVICES.md.
#
# Sender preference: `wakeonlan` if installed, else a pure-python3 UDP
# magic-packet fallback (SO_BROADCAST — bash's /dev/udp can't set that, python
# can). `etherwake` needs cap_net_raw/root and this tool NEVER runs sudo
# (no controlling tty → pam failure → faillock lockout), so if etherwake is
# the only option we print the exact sudo command for the user to run.

set -euo pipefail

have() { command -v "$1" >/dev/null 2>&1; }

if [[ -t 1 ]] && command -v tput >/dev/null 2>&1; then
  C_OK=$(tput setaf 2); C_BAD=$(tput setaf 1); C_DIM=$(tput dim); C_BOLD=$(tput bold); C_RESET=$(tput sgr0)
else
  C_OK=""; C_BAD=""; C_DIM=""; C_BOLD=""; C_RESET=""
fi

usage() {
  cat <<'EOF'
wol — send Wake-on-LAN magic packet

USAGE:
  wol AA:BB:CC:DD:EE:FF       # by raw MAC
  wol nova                     # by alias (looked up in DEVICES.md)
  wol --list                   # list known aliases
  wol -b 192.168.1.255 MAC    # explicit broadcast address (default: 255.255.255.255)

DEVICES.md lookup:
  Looks at $HOME_NETWORK_SKILL_DEVICES (env var) or the installed skill's
  references/DEVICES.md. Aliases come from device section headers (### Name).

WoL gotchas:
  - Target NIC needs WoL enabled in BIOS AND in the OS (ethtool -s eth0 wol g).
  - Target must be on the same broadcast domain as you.
  - See TROUBLESHOOTING.md "Wake-on-LAN doesn't work".
EOF
}

# locate DEVICES.md
locate_devices() {
  if [[ -n "${HOME_NETWORK_SKILL_DEVICES:-}" ]] && [[ -r "$HOME_NETWORK_SKILL_DEVICES" ]]; then
    echo "$HOME_NETWORK_SKILL_DEVICES"; return 0
  fi
  # try this script's own repo first (survives moves), then installed locations
  local self_refs
  self_refs="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." 2>/dev/null && pwd || true)/skills/home-network/references"
  for candidate in \
    "$self_refs/DEVICES.md" \
    "$HOME/.claude/skills/home-network/references/DEVICES.md" \
    "$HOME/repos/claude-skills/plugins/home-network/skills/home-network/references/DEVICES.md" \
    "$HOME/repos/home-network-skill/skills/home-network/references/DEVICES.md"; do
    [[ -r "$candidate" ]] && { echo "$candidate"; return 0; }
  done
  return 1
}

list_aliases() {
  local devfile
  devfile=$(locate_devices) || { echo "no DEVICES.md found" >&2; exit 2; }
  echo "${C_BOLD}Aliases from $devfile:${C_RESET}"
  # Pull H3 section headers (### name) and the first MAC-bearing row per
  # section. The MAC may be wrapped in backticks/bold in the table, so we
  # only require a row mentioning "MAC" with a MAC pattern ANYWHERE in it.
  awk '
    /^### / { current_alias=substr($0,5); shown=0; next }
    !shown && /MAC/ && match($0, /([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}/) {
      mac = substr($0, RSTART, RLENGTH)
      if (current_alias != "") { printf "  %-30s %s\n", current_alias, mac; shown=1 }
    }
  ' "$devfile"
}

# alias → MAC via DEVICES.md
alias_to_mac() {
  local alias="$1"
  local devfile
  devfile=$(locate_devices) || return 1
  # Match case-insensitively in the alias header. LITERAL matching only
  # (index/word compare, never `~`) so regex metachars in the query can't
  # break awk. Prefer a whole-word match over a substring match so a short
  # query ("no") can't grab the wrong section when an exact word ("nova")
  # exists elsewhere. MAC may be backtick-wrapped — require only a row
  # mentioning "MAC" with a MAC pattern anywhere; extract with match().
  awk -v want="${alias,,}" '
    function has_word(h, w,   n, parts, i) {
      n = split(h, parts, /[^a-z0-9._-]+/)
      for (i = 1; i <= n; i++) if (parts[i] == w) return 1
      return 0
    }
    BEGIN { in_section = 0; is_word = 0; word_mac = ""; sub_mac = "" }
    /^### / {
      header = tolower(substr($0, 5))
      is_word = has_word(header, want)
      in_section = (is_word || index(header, want) > 0) ? 1 : 0
      next
    }
    in_section && /MAC/ && match($0, /([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}/) {
      mac = substr($0, RSTART, RLENGTH)
      if (is_word) { if (word_mac == "") word_mac = mac }
      else         { if (sub_mac  == "") sub_mac  = mac }
      in_section = 0
    }
    END {
      if (word_mac != "") print word_mac
      else if (sub_mac != "") print sub_mac
    }
  ' "$devfile"
}

# --- args ---
TARGET=""
BCAST="255.255.255.255"
LIST=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --list) LIST=1; shift ;;
    -b|--broadcast) BCAST="$2"; shift 2 ;;
    *) TARGET="$1"; shift ;;
  esac
done

if (( LIST )); then
  list_aliases
  exit 0
fi

if [[ -z "$TARGET" ]]; then
  usage >&2
  exit 2
fi

# resolve target to MAC
MAC=""
if [[ "$TARGET" =~ ^([0-9a-fA-F]{2}[:-]){5}[0-9a-fA-F]{2}$ ]]; then
  MAC="$TARGET"
else
  MAC=$(alias_to_mac "$TARGET" || true)
  if [[ -z "$MAC" ]]; then
    echo "${C_BAD}wol: alias '$TARGET' not found in DEVICES.md${C_RESET}" >&2
    echo "      try: wol --list" >&2
    exit 1
  fi
  echo "${C_DIM}resolved alias '$TARGET' → $MAC${C_RESET}"
fi

# pick a sender and go
if have wakeonlan; then
  echo "${C_BOLD}sending magic packet (via wakeonlan) to $MAC → $BCAST${C_RESET}"
  wakeonlan -i "$BCAST" "$MAC"
elif have python3; then
  # Pure-python fallback: UDP magic packet with SO_BROADCAST (which bash's
  # /dev/udp cannot set). No raw sockets, no privileges needed.
  echo "${C_BOLD}sending magic packet (via python3) to $MAC → $BCAST${C_RESET}"
  python3 - "$MAC" "$BCAST" <<'PYEOF'
import socket, sys
mac, bcast = sys.argv[1], sys.argv[2]
payload = bytes.fromhex("ff" * 6 + mac.replace(":", "").replace("-", "") * 16)
s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
s.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)
s.sendto(payload, (bcast, 9))
s.close()
PYEOF
elif have etherwake; then
  # etherwake needs cap_net_raw or root. NEVER run sudo from here — with no
  # controlling tty the pam conversation fails and each attempt accumulates
  # in pam_faillock, locking the account. Print the command instead.
  WOL_IFACE=$(ip -4 route show default 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="dev"){print $(i+1); exit}}')
  echo "${C_BAD}wol: only 'etherwake' is available, and it needs cap_net_raw (this tool never runs sudo)${C_RESET}" >&2
  echo "      run this yourself in a terminal:" >&2
  echo "        sudo etherwake -i ${WOL_IFACE:-eth0} $MAC" >&2
  echo "      or grant the capability once:" >&2
  echo "        sudo setcap cap_net_raw+eip \$(command -v etherwake)" >&2
  exit 2
else
  echo "${C_BAD}wol: no usable sender ('wakeonlan', 'python3', or 'etherwake')${C_RESET}" >&2
  echo "      pure-bash WoL can't broadcast (no SO_BROADCAST in /dev/udp)" >&2
  echo "      install:" >&2
  echo "        Arch/CachyOS (AUR):  yay -S wakeonlan   # or: yay -S etherwake-git" >&2
  echo "        Debian/Ubuntu:       sudo apt install wakeonlan" >&2
  echo "        Fedora:              sudo dnf install wol" >&2
  echo "        macOS:               brew install wakeonlan" >&2
  exit 2
fi
