+# LOCAL PATCH (komi, 2026-08-13): publish raw numbers to a shared feed dir so a
+# single usage panel can render one bar per PROVIDER, instead of this plugin's
+# per-workspace tokens repeating the same account-wide number on every space row.
+# herdr metadata only has workspace and pane scope — there is no account/global
+# scope — so de-duplicating has to happen outside the token system entirely.
+# This plugin stays the sole Anthropic poller: nothing else should hold the OAuth
+# token or add rate-limit pressure. Future providers write the same shape.
+FEED_DIR = os.path.expanduser("~/.local/state/herdr-usage")
+
+
+def publish_feed(last_good):
+    try:
+        os.makedirs(FEED_DIR, exist_ok=True)
+        for name, usage in last_good.items():
+            payload = {
+                "provider": "anthropic",
+                "label": "anthropic" if name == "claude" else f"anthropic:{name}",
+                "session_pct": usage["session"]["pct"],
+                "week_pct": usage["week"]["pct"],
+                "session_resets_at": usage["session"].get("resets_at"),
+                "week_resets_at": usage["week"].get("resets_at"),
+                "updated": time.time(),
+            }
+            path = os.path.join(FEED_DIR, f"anthropic-{name}.json")
+            tmp = f"{path}.tmp"
+            with open(tmp, "w", encoding="utf-8") as f:
+                json.dump(payload, f)
+            os.replace(tmp, path)  # atomic: the panel may be mid-read
+    except Exception:
+        pass  # the feed is display-only; never break the sidebar path over it
+
