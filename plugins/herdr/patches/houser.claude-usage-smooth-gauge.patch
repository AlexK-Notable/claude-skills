+# LOCAL PATCH (komi, 2026-08-13): smooth gauge instead of ■/□ segments.
+# Eighth-block glyphs give 8 sub-steps per cell = 80 steps across the bar,
+# vs 10 for the segmented version. That is not just cosmetic: at 10 cells,
+# 3% and 7% both rendered identically, and 7% rounded up to a FULL square,
+# overstating it as 10%.
+GAUGE_BLOCKS = "▏▎▍▌▋▊▉█"  # 1/8 .. 8/8 of a cell
+GAUGE_TRACK = "░"          # unfilled remainder; same fg, reads as a lighter track
+# GAUGE_SUBCELL trades continuity for precision, and it is a real trade:
+#   True  — 80 steps, but a partial cell like ▏ sits at the LEFT of its cell and
+#           leaves the rest of that cell blank, so a visible gap opens between
+#           the fill and the track. Precision at the cost of a broken-looking bar.
+#   False — 10 steps, but █ and ░ both fill their cell edge to edge, so the bar
+#           is perfectly continuous. This is what "smooth bar" actually looks like.
+GAUGE_SUBCELL = False
