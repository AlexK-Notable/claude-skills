#!/usr/bin/env bash
# bws-secret-add — create a Bitwarden Secrets Manager secret WITHOUT leaking the
# value into shell history or argv-via-your-shell. The value is read hidden from
# the TTY, or from stdin if piped. Created-item output is stripped of plaintext.
#
# Usage:
#   bws-secret-add <KEY> [PROJECT_ID] [--note "text"]
#   printf '%s' "$value" | bws-secret-add <KEY> [PROJECT_ID]      # non-interactive
#
#   KEY         secret name. Use UPPER_SNAKE_CASE — it becomes the environment
#               variable name under `bws run`.
#   PROJECT_ID  target project UUID. Resolution order:
#                 1. this argument
#                 2. $BWS_PROJECT_ID
#                 3. the sole accessible project, if exactly one exists
#   --note      optional note stored with the secret
#
# Auth: needs BWS_ACCESS_TOKEN. If unset, sources ~/.config/bws/token.env (600).
#
# CAVEAT: bws 2.1.0 has no stdin input for the value, so `bws secret create` still
# receives it as an argv element — briefly visible in local `ps`/proc to this user.
# This wrapper removes the *shell-history* and interactive-echo exposure, which is
# the part that actually persists. There is no way around the argv hop in 2.1.0.
#
# Part of the bitwarden-cli skill:
#   ~/.claude/skills/bitwarden-cli/references/secrets-manager.md
set -euo pipefail

usage() {
  cat <<'EOF'
bws-secret-add — create a Bitwarden Secrets Manager secret without leaking the
value into shell history. Reads the value hidden from the TTY, or from stdin.

Usage:
  bws-secret-add <KEY> [PROJECT_ID] [--note "text"]
  printf '%s' "$value" | bws-secret-add <KEY> [PROJECT_ID]

  KEY         secret name (UPPER_SNAKE_CASE — becomes the env var under `bws run`)
  PROJECT_ID  project UUID; defaults to $BWS_PROJECT_ID, else the sole project
  --note      optional note stored with the secret

Auth: needs BWS_ACCESS_TOKEN; if unset, sources ~/.config/bws/token.env (600).
EOF
}
die() { printf 'bws-secret-add: %s\n' "$*" >&2; exit 1; }

# --- parse args ---------------------------------------------------------------
KEY=""; PROJECT_ID=""; NOTE=""
while (($#)); do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --note) NOTE="${2:-}"; shift 2 ;;
    --note=*) NOTE="${1#--note=}"; shift ;;
    -*) die "unknown option: $1 (try --help)" ;;
    *)
      if   [[ -z "$KEY" ]];        then KEY="$1"
      elif [[ -z "$PROJECT_ID" ]]; then PROJECT_ID="$1"
      else die "unexpected argument: $1"; fi
      shift ;;
  esac
done
[[ -n "$KEY" ]] || { usage; exit 2; }
[[ "$KEY" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || \
  printf 'bws-secret-add: warning: %q is not a valid env-var name; it may not surface under `bws run`\n' "$KEY" >&2

# --- auth ---------------------------------------------------------------------
if [[ -z "${BWS_ACCESS_TOKEN:-}" ]]; then
  tok="$HOME/.config/bws/token.env"
  [[ -r "$tok" ]] || die "BWS_ACCESS_TOKEN unset and $tok unreadable — stash the token first"
  set -a; . "$tok"; set +a
fi
[[ -n "${BWS_ACCESS_TOKEN:-}" ]] || die "BWS_ACCESS_TOKEN still empty after sourcing token file"
command -v bws >/dev/null 2>&1 || die "bws not found in PATH"

# --- resolve project ----------------------------------------------------------
[[ -n "$PROJECT_ID" ]] || PROJECT_ID="${BWS_PROJECT_ID:-}"
if [[ -z "$PROJECT_ID" ]]; then
  command -v jq >/dev/null 2>&1 || die "no PROJECT_ID and jq unavailable to auto-detect one"
  mapfile -t ids < <(bws project list -o json 2>/dev/null | jq -r '.[].id')
  case "${#ids[@]}" in
    1) PROJECT_ID="${ids[0]}" ;;
    0) die "no accessible projects — check BWS_ACCESS_TOKEN" ;;
    *) die "multiple projects accessible — pass PROJECT_ID (see: bws project list -o table)" ;;
  esac
fi

# --- read the value (hidden TTY, or stdin if piped) ---------------------------
if [[ -t 0 ]]; then
  read -rsp "Value for $KEY: " VALUE; echo
else
  VALUE="$(cat)"
fi
[[ -n "$VALUE" ]] || die "empty value — aborting"

# --- create, then show metadata only ------------------------------------------
extra=()
[[ -n "$NOTE" ]] && extra+=(--note "$NOTE")

if command -v jq >/dev/null 2>&1; then
  bws secret create "$KEY" "$VALUE" "$PROJECT_ID" "${extra[@]}" -o json \
    | jq '{id, key, projectId, creationDate}'
else
  bws secret create "$KEY" "$VALUE" "$PROJECT_ID" "${extra[@]}" -o none \
    && printf '✓ created secret %s in project %s\n' "$KEY" "$PROJECT_ID"
fi
unset VALUE
