{
  "agentic-engineering": {
    "type": "domain",
    "enforcement": "suggest",
    "priority": "high",
    "description": "Engineering systems around frontier LLM agents — context, prompts, tools, multi-agent orchestration, loops",
    "promptTriggers": {
      "keywords": [
        "agentic",
        "agent system",
        "agent architecture",
        "multi-agent",
        "subagent",
        "orchestrator",
        "orchestrator-worker",
        "dispatch prompt",
        "context engineering",
        "context window",
        "context budget",
        "context rot",
        "prompt engineering",
        "tool design",
        "stop condition",
        "progressive disclosure",
        "prompt caching",
        "agent loop",
        "single vs multi-agent",
        "worker prompt",
        "subagent prompt",
        "skill description",
        "SKILL.md",
        "cache layout",
        "cache hit rate",
        "verify agent output",
        "agent says done",
        "tool catalog"
      ],
      "intentPatterns": [
        "(design|build|architect|structure).*?(agent|multi-?agent|subagent|agentic).*?(system|workflow|pipeline|loop)",
        "(single|multi)[\\s-]?agent",
        "(write|design|craft).*?(dispatch|orchestrat|subagent|agent).*?prompt",
        "(manage|reduce|optimize|shrink).*?context\\s*(window|budget|length|rot)",
        "context\\s*(engineering|rot|degradation|window|budget)",
        "(stop|termination|halt|end).*?condition",
        "why.*?(agent|multi-?agent).*?(fail|failing|degrad|broke|broken)",
        "(prompt|context)\\s*(cach|caching)",
        "progressive disclosure",
        "(design|build).*?tools?\\s+for.*?(agent|llm|model)",
        "(worker|subagent|sub-agent|dispatch)\\s+prompt",
        "prompt\\s+for\\s+(a|my|the|each)?\\s*(worker|sub-?agent|orchestrator)",
        "(writ|author|build|creat|updat)\\w*\\s+(a\\s+)?(skill|plugin|llms\\.txt|knowledge package)",
        "skill\\s*(description|frontmatter)|frontmatter\\s+description",
        "(verify|verifying|validate|check).{0,20}(agent|subagent|worker).{0,20}(output|result|work|claim|report)",
        "agent\\s+(says|claims|reports|thinks).{0,20}(done|complete|finished|succeeded|passing)",
        "cache\\s*(layout|hit rate|prefix|breakpoint|invalidat)",
        "(tool|function)\\s+catalog",
        "(how many|too many)\\s+tools"
      ]
    },
    "fileTriggers": {
      "pathPatterns": [
        "**/agents/**/*.md",
        "**/.claude/agents/**",
        "**/subagents/**"
      ],
      "contentPatterns": [
        "subagent_type",
        "orchestrator[- ]worker",
        "multi-?agent",
        "dispatch.*?agent"
      ]
    }
  }
}
