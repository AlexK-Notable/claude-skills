{
  "home-assistant": {
    "type": "domain",
    "enforcement": "suggest",
    "priority": "high",
    "description": "Operate the self-hosted Home Assistant (HA in Docker on the Nova, 192.168.1.229). Safe-mutation discipline (back up + check_config before edits; .storage edits need HA stopped), a secret-safe inventory snapshot (ha-inventory), and append-only gotcha capture (ha-note). Covers automations, scripts, dashboards, the Assist voice pipeline, exposed entities, HACS, Govee lights, the Z-Print/Moonraker printer, and Glances sensors.",
    "promptTriggers": {
      "keywords": [
        "home assistant",
        "homeassistant",
        "home-assistant",
        "hass",
        "HA automation",
        "HA dashboard",
        "automations.yaml",
        "configuration.yaml",
        "scripts.yaml",
        ".storage",
        "config_entries",
        "entity_registry",
        "exposed_entities",
        "assist pipeline",
        "assist",
        "voice assistant",
        "sentence trigger",
        "wyoming",
        "openwakeword",
        "piper",
        "sensevoice",
        "HACS",
        "lovelace",
        "ha-inventory",
        "ha-note",
        "govee",
        "govee2mqtt",
        "moonraker",
        "z-print",
        "glances",
        "nabu",
        "ok nabu",
        "exposed entities",
        "blueprint"
      ],
      "intentPatterns": [
        "(home ?assistant|hass|nabu)",
        "(create|add|edit|fix|write|set ?up).*?(automation|script|scene|dashboard|blueprint)",
        "(expose|exposed).*?(entit|script|device).*?(assist|voice|conversation)",
        "(voice|assist).*?(command|pipeline|agent|intent|sentence)",
        "(edit|change|read|parse).*?\\.storage",
        "(turn (on|off)|set|dim|toggle).*?(light|switch|lamp|bulb|scene)",
        "(govee|moonraker|z-?print|glances|spotify).*?(light|sensor|printer|entit|integration)",
        "(install|add|configure).*?(integration|HACS|hacs)",
        "(check_config|reload|restart).*?(home ?assistant|hass|automation)",
        "ha-(inventory|note)"
      ]
    }
  }
}
