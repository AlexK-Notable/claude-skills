#!/usr/bin/env python3
"""ha-note — capture one operational gotcha to the home-assistant skill's journal.

Channel B of the home-assistant skill, lean model: NO LLM, append-only. Every
call atomically appends one structured entry to references/GOTCHAS.journal.md.
The journal is the durable artifact; promotion of well-worn entries into the
curated GOTCHAS.md is done by hand (an edit), never by an automated rewrite.

Why structured + provenance (not freeform): the research on self-learning agents
is blunt that the cardinal failure is capturing a WRONG lesson and then acting on
it confidently later. So every entry records:
  - status: verified | unverified  (unverified = do NOT act on without re-checking)
  - a repro/verify command          (how to re-confirm it's still true)
  - the HA version it was seen on    (gotchas are version-sensitive)
  - applies-when                     (kills "misapplied in the wrong context")

CAPTURE ONLY non-discoverable failures/surprises (see the skill's checklist):
version-specific behavior changes, undocumented service/entity quirks, a
documented fact that was wrong, or an integration gotcha. Do NOT log successes
or anything re-derivable from the code/inventory.

Usage:
  ha-note "summary" --cause "..." --fix "..." \
      [--verified | --unverified] [--repro "command"] \
      [--ha-version 2026.5.4] [--applies "container install only"] \
      [--tag bluetooth --tag govee]

  ha-note --list                       # print the whole journal
  ha-note --list --grep govee          # only entries containing "govee" (case-insensitive)
  ha-note --list --tag bluetooth       # only entries tagged "bluetooth" (repeatable, ANDed)
  ha-note --pending         # verified entries not yet in GOTCHAS.md (promotion candidates)
  ha-note --selftest        # verify the capture path works (self-cleaning; journal untouched)
"""
import os
import re
import sys
import fcntl
import hashlib
import argparse
from datetime import datetime, timezone


def _references_dir():
    here = os.path.dirname(os.path.realpath(__file__))      # .../scripts
    plugin = os.path.dirname(here)                          # .../home-assistant
    return os.path.join(plugin, "skills", "home-assistant", "references")


JOURNAL = os.path.join(_references_dir(), "GOTCHAS.journal.md")
JOURNAL_HEADER = """\
# GOTCHAS — journal (append-only meta-record, captured via `ha-note`)

A dated record of paths taken and what was believed AT THE TIME — provenance,
NOT a live mirror of HA. Append via `ha-note`; never rewrite or delete an entry.
Promote well-worn entries into the curated `GOTCHAS.md` by hand. When an entry
later proves wrong/stale, DON'T edit it — file a revision in the companion
`GOTCHAS.revisions.md` via `ha-note --supersede <ref>`; `ha-note --list` then
flags it. `unverified` entries must be re-checked before you act on them.

---
"""


def append_entry(text, path=JOURNAL, header=JOURNAL_HEADER):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    # Atomic append under an exclusive lock (safe across concurrent callers).
    # "a" creates the file if absent; the header decision happens UNDER the
    # lock (fstat of the locked fd), so two concurrent first-callers can't
    # both decide to write the header.
    with open(path, "a") as f:
        fcntl.flock(f.fileno(), fcntl.LOCK_EX)
        try:
            if os.fstat(f.fileno()).st_size == 0:
                f.write(header)
            f.write(text)
            f.flush()
            os.fsync(f.fileno())
        finally:
            fcntl.flock(f.fileno(), fcntl.LOCK_UN)


def build_entry(a):
    now = datetime.now(timezone.utc).strftime("%Y-%m-%d")
    status = "verified" if a.verified else "unverified"
    lines = [f"\n### {now} — {a.summary}"]
    lines.append(f"- **Status:** {status}"
                 + ("  ⚠ re-check before acting" if not a.verified else ""))
    if a.ha_version:
        lines.append(f"- **HA version:** {a.ha_version}")
    if a.cause:
        lines.append(f"- **Cause:** {a.cause}")
    if a.fix:
        lines.append(f"- **Fix:** {a.fix}")
    if a.repro:
        lines.append(f"- **Repro / verify:** `{a.repro}`")
    if a.applies:
        lines.append(f"- **Applies when:** {a.applies}")
    if a.tag:
        lines.append(f"- **Tags:** " + ", ".join(a.tag))
    return "\n".join(lines) + "\n"


def list_journal(grep=None, tags=()):
    """Print the journal, optionally filtered by --grep / --tag.

    The journal is 140+ lines and growing — agents need filtered reads, not
    the whole file, to find the one relevant gotcha."""
    if not os.path.exists(JOURNAL):
        print("(journal empty — nothing captured yet)")
        return 0
    text = open(JOURNAL).read()
    if not grep and not tags:
        sys.stdout.write(text)
        return 0
    # Split into entries: each starts at a line beginning "### " (the dated
    # heading). Everything before the first heading is the file header — skipped.
    entries = []
    cur = None
    for line in text.splitlines():
        if line.startswith("### "):
            if cur:
                entries.append("\n".join(cur).strip("\n"))
            cur = [line]
        elif cur is not None:
            cur.append(line)
    if cur:
        entries.append("\n".join(cur).strip("\n"))

    def keep(entry):
        if grep and grep.lower() not in entry.lower():
            return False
        if tags:
            m = re.search(r"^- \*\*Tags:\*\* (.+)$", entry, re.M)
            have = {t.strip().lower() for t in m.group(1).split(",")} if m else set()
            if not all(t.lower() in have for t in tags):
                return False
        return True

    matched = [e for e in entries if keep(e)]
    if matched:
        sys.stdout.write("\n\n".join(matched) + "\n")
    print(f"({len(matched)}/{len(entries)} entries matched)", file=sys.stderr)
    return 0


CURATED = os.path.join(_references_dir(), "GOTCHAS.md")
_STOP = set(
    "the a an and or of to is are was were for in on with you your it its not no be by "
    "as at do does dont can cant use used using via per when then this that if so we our "
    "they them but into out off only need needs make does only via from has have had".split())


def _sig_tokens(s):
    return {w for w in re.findall(r"[a-z0-9_]{4,}", s.lower()) if w not in _STOP}


def pending_promotions():
    """REVIEW AID (heuristic, not authoritative): list *verified* journal entries
    that don't appear to be in the curated GOTCHAS.md yet, so promotion candidates
    are easy to spot. Matching is by title-word overlap — you still decide what to
    promote and where. Promotion itself stays a hand edit (the skill's rule)."""
    if not os.path.exists(JOURNAL):
        print("(journal empty — nothing to promote)")
        return 0
    curated = open(CURATED).read() if os.path.exists(CURATED) else ""
    curated_heads = [blk.split("\n", 1)[0] for blk in re.split(r"^### ", curated, flags=re.M)[1:]]
    curated_tok = [_sig_tokens(h) for h in curated_heads]

    # parse journal into (heading, body) entries
    entries, cur = [], None
    for line in open(JOURNAL).read().splitlines():
        if line.startswith("### "):
            if cur:
                entries.append(cur)
            cur = {"head": line[4:], "body": [line]}
        elif cur is not None:
            cur["body"].append(line)
    if cur:
        entries.append(cur)

    pending, promoted = [], []
    for e in entries:
        if "selftest" in e["head"].lower():
            continue
        if "**status:** verified" not in "\n".join(e["body"]).lower():
            continue  # only surface verified lessons for promotion
        t = _sig_tokens(e["head"])
        best, where = 0, None
        for h, ct in zip(curated_heads, curated_tok):
            ov = len(t & ct)
            if ov > best:
                best, where = ov, h.strip()
        (promoted if best >= 3 else pending).append((e["head"], where, best))

    print(f"=== PENDING promotion — verified, not obviously in GOTCHAS.md ({len(pending)}) ===")
    for head, _, _ in pending:
        print(f"  ● {head}")
    if not pending:
        print("  (none — every verified entry has a likely match in GOTCHAS.md)")
    if promoted:
        print(f"\n=== likely already promoted ({len(promoted)}) ===")
        for head, where, n in promoted:
            print(f"  ✓ {head[:90]}\n      ↳ ~ \"{where}\" ({n} shared words)")
    print("\n(heuristic by title-word overlap — verify before trusting; promote by hand.)")
    return 0


def main():
    p = argparse.ArgumentParser(add_help=True)
    p.add_argument("summary", nargs="?", help="one-line symptom/lesson")
    p.add_argument("--cause")
    p.add_argument("--fix")
    p.add_argument("--repro", help="exact command that demonstrates/verifies it")
    p.add_argument("--applies", help="scope: HA version range, container vs HAOS, host, etc.")
    p.add_argument("--ha-version", dest="ha_version")
    p.add_argument("--tag", action="append", default=[])
    g = p.add_mutually_exclusive_group()
    g.add_argument("--verified", action="store_true")
    g.add_argument("--unverified", action="store_true")
    p.add_argument("--list", action="store_true")
    p.add_argument("--grep", metavar="TERM",
                   help="with --list: only entries containing TERM (case-insensitive)")
    p.add_argument("--selftest", action="store_true")
    p.add_argument("--pending", action="store_true",
                   help="list verified journal entries not yet in GOTCHAS.md (promotion candidates)")
    a = p.parse_args()

    if a.list:
        return list_journal(grep=a.grep, tags=a.tag)

    if a.selftest:
        # Exercise the REAL append path (header-init + locked write + fsync) on a
        # throwaway file IN THE JOURNAL'S DIRECTORY — proves that directory is
        # writable (a dead path = silent stop-learning) WITHOUT polluting the
        # journal with a "delete me" entry. Self-cleaning.
        test_path = os.path.join(os.path.dirname(JOURNAL), ".ha-note-selftest.tmp")
        try:
            if os.path.exists(test_path):
                os.unlink(test_path)
            append_entry("\n### SELFTEST\n- **Status:** verified (synthetic)\n", path=test_path)
            grew = os.path.getsize(test_path) > 0
            head_ok = open(test_path).read().startswith("# GOTCHAS — journal")
            ok = grew and head_ok
            print("ha-note selftest: "
                  + ("OK — append path + header-init work; journal untouched" if ok
                     else f"FAILED (grew={grew}, header-init={head_ok})"))
            return 0 if ok else 1
        finally:
            if os.path.exists(test_path):
                os.unlink(test_path)

    if a.pending:
        return pending_promotions()

    if not a.summary:
        p.error("summary is required (or use --list / --selftest)")
    # Entries default to unverified (argparse store_true) — fail safe: a gotcha
    # is only `verified` when the caller explicitly asserts --verified.

    append_entry(build_entry(a))
    status = "verified" if a.verified else "unverified (re-check before acting)"
    print(f"ha-note: captured [{status}] → {JOURNAL}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
